# ──────────────────────────────────────────────────────────────────────────
# SmartDine Admin — Production Environment
# ──────────────────────────────────────────────────────────────────────────

# LOCAL API — In production, the POS hub URL resolves to App Engine.
# Flutter/Waiter apps connect to the local Spring Boot directly via LAN.
VITE_API_URL=https://smartdine-saas.ew.r.appspot.com

# CLOUD API — Same App Engine URL in production (no localhost in prod).
# Routes: isTest=true → smartdine_dev, isTest=false → smartdine (production DB).
VITE_CLOUD_API_URL=https://smartdine-saas.ew.r.appspot.com
