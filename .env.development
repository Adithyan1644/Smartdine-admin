# ──────────────────────────────────────────────────────────────────────────
# SmartDine Admin — Development Environment
# ──────────────────────────────────────────────────────────────────────────

# LOCAL API — Your local Spring Boot POS hub (offline-first, LAN-speed)
# Used by: live orders, menu sync, tables, KDS, waiter management.
# Requires: local Spring Boot running on this machine.
VITE_API_URL=http://localhost:8080

# CLOUD API — GCP App Engine Gateway (requires internet)
# Used by: account registration only (routes isTest → correct GCP database).
#   isTest=true  → smartdine_dev (sandbox database)
#   isTest=false → smartdine     (production database)
VITE_CLOUD_API_URL=https://smartdine-saas.ew.r.appspot.com
